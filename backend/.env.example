# FormFlow Backend Environment Variables
# Copy this to .env and fill in your values

# Google Gemini API Key (required for real AI mode)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Max upload size in bytes (default 20MB)
MAX_UPLOAD_SIZE=20971520

# Temp directory for uploaded files (uses system temp if not set)
# TEMP_DIR=/tmp/formflow
